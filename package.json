{
  "name": "ai-desktop-buddy",
  "version": "0.45.0",
  "description": "A desktop AI character (Scout) you can talk to that researches the web and answers out loud.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg"
  },
  "license": "MIT",
  "build": {
    "appId": "com.nexus.desktopbuddy",
    "productName": "Nexus",
    "files": [
      "main.js",
      "preload.js",
      "content/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Nexus uses the microphone so you can talk to your AI agents."
      }
    },
    "dmg": {
      "title": "Nexus"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "dotenv": "^17.4.2",
    "nodemailer": "^9.0.5",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "googleapis": "^174.0.1"
  }
}
